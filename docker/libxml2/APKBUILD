# Derived from Alpine 3.24 main/libxml2/APKBUILD; MIT.
# Local revision reserved for this temporary backport; not an Alpine release.
pkgname=libxml2
pkgver=2.13.9
pkgrel=2000
pkgdesc="XML parsing library (Notification Hub CVE-2026-86140 backport)"
url="https://gitlab.gnome.org/GNOME/libxml2"
arch="all"
license="MIT"
makedepends="zlib-dev xz-dev"
checkdepends="perl tar python3"
subpackages="$pkgname-dev $pkgname-doc $pkgname-static $pkgname-utils"
source="https://download.gnome.org/sources/libxml2/2.13/libxml2-$pkgver.tar.xz
 https://raw.githubusercontent.com/alpinelinux/aports/3.24-stable/main/libxml2/CVE-2026-6732.patch
 https://raw.githubusercontent.com/alpinelinux/aports/3.24-stable/main/libxml2/CVE-2026-6732-test.patch
 CVE-2026-86140.patch
"
prepare() {
    # Retain original code only for the negative regression control in the builder.
    cp "$builddir/valid.c" "$srcdir/valid-before.c"
    default_prepare
    rm test/icu_parse_test.xml
}
build() {
    ./configure --build="$CBUILD" --host="$CHOST" --prefix=/usr \
        --sysconfdir=/etc --enable-static --with-legacy --with-lzma \
        --with-zlib --without-python
    make
}
check() {
    rm -f test/ebcdic_566012.xml
    make runtests
    python3 /backport/bounds-check.py "$srcdir/valid-before.c" valid.c
}
package() {
    make -j1 DESTDIR="$pkgdir" install
    mkdir -p "$pkgdir/usr/share/notification-hub"
    cp /backport/CVE-2026-86140.patch "$pkgdir/usr/share/notification-hub/"
}
utils() {
    pkgdesc="XML utilities"
    amove usr/bin
}
